# The Grand Maharaja - Environment Configuration
# All form inquiries are automatically sent to: info@thegrandmaharaja.co.uk

RECIPIENT_EMAIL=info@thegrandmaharaja.co.uk

# SMTP Email Configuration (Optional - for direct email dispatch via Nodemailer)
# Provide your email provider credentials (e.g., cPanel Webmail, Google Workspace, SendGrid, etc.)
# If left blank, inquiries will be logged securely in server logs and return success.

SMTP_HOST=mail.thegrandmaharaja.co.uk
SMTP_PORT=465
SMTP_USER=info@thegrandmaharaja.co.uk
SMTP_PASS=your_email_password_or_app_password
SMTP_FROM="The Grand Maharaja Website" <info@thegrandmaharaja.co.uk>
